# ─── AI ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here

# ─── ALERTS (pick one or both) ────────────────────────────
# Telegram Bot (free — recommended)
# Create via @BotFather on Telegram, then start your bot to get chat_id
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Email alerts via Gmail SMTP (optional)
ALERT_EMAIL_FROM=you@gmail.com
ALERT_EMAIL_TO=you@gmail.com
ALERT_EMAIL_PASSWORD=your_gmail_app_password   # Gmail App Password, not your real password

# ─── AGENT CONFIG ─────────────────────────────────────────
DRY_RUN=true                  # false = actually purchase (use with caution!)
CHECK_INTERVAL_MINUTES=60     # how often to check prices
TIMEZONE=Asia/Karachi
CURRENCY=USD

# ─── PURCHASE CONFIG (live mode only) ─────────────────────
AUTO_PURCHASE=false           # set to true to enable auto-buy
MAX_AUTO_PURCHASE_USD=50      # never auto-buy above this price

# ─── CRITERIA (global defaults, overridable per product) ──
DEFAULT_DROP_THRESHOLD=10     # alert if price drops by this % or more
DEFAULT_MAX_PRICE=500         # never recommend above this price
